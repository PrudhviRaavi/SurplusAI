# ==============================================================================
# FoodShareAI ML Microservice - Environment Configuration Template
# Standalone Python FastAPI service hosting YOLOv8, EfficientNet, XGBoost, LSTM, and Isolation Forest.
# ==============================================================================

# Server Network Settings
ML_SERVICE_PORT=8000
ML_SERVICE_HOST=0.0.0.0

# Model File Locations (Defaults resolve to ml-service/models/*)
# FOOD_DETECTION_MODEL_PATH=models/food_detection/best.pt
# FRESHNESS_MODEL_PATH=models/freshness/efficientnet_b0_freshness.pth
# QUANTITY_MODEL_PATH=models/quantity/quantity_regressor.joblib
# QUANTITY_SEG_MODEL_PATH=models/quantity/yolov8_seg.pt
# EXPIRY_MODEL_PATH=models/expiry/xgboost_expiry.joblib
# DEMAND_MODEL_PATH=models/demand/lstm_demand.pth
# FRAUD_MODEL_PATH=models/fraud/isolation_forest.joblib

# Model Version Identifiers
MODEL_VERSION_FOOD_DETECTION=food_detection_v1
MODEL_VERSION_FRESHNESS=freshness_v1
MODEL_VERSION_QUANTITY=quantity_seg_v1
MODEL_VERSION_EXPIRY=expiry_v1
MODEL_VERSION_DEMAND=demand_lstm_v1
MODEL_VERSION_FRAUD=isolation_forest_v1

# LSTM Architecture Hyperparameters
DEMAND_SEQUENCE_LENGTH=7
DEMAND_HIDDEN_SIZE=64
DEMAND_NUM_LAYERS=2
DEMAND_DROPOUT=0.2
