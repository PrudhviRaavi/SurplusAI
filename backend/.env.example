# ==============================================================================
# FoodShareAI Backend - Environment Configuration Template
# Copy this file to backend/.env and supply appropriate credentials.
# NEVER commit real production secrets or connection strings to version control.
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:8081

# Database Configuration (MongoDB Atlas or Local Connection String)
# Example: mongodb+srv://<username>:<password>@cluster.mongodb.net/foodshareai?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/foodshareai

# Authentication & JWT Security
# Ensure JWT_SECRET is a cryptographically random string (e.g. openssl rand -base64 32)
JWT_SECRET=super_secure_foodshare_jwt_secret_key_change_in_production_32chars
JWT_EXPIRES_IN=1d

# Custom Python ML Microservice Connection
ML_SERVICE_URL=http://localhost:8000
ML_FRAUD_TIMEOUT_MS=3000

# Real-Time Telemetry & Tracking
LOCATION_UPDATE_INTERVAL_MS=3000

# Notification Infrastructure
PUSH_TIMEOUT_MS=5000

# Initial Admin Bootstrap (npm run create-admin)
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@foodshareai.org
ADMIN_PASSWORD=AdminSecurePass123!
