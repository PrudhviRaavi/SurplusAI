# ==============================================================================
# FoodShareAI Mobile/Web Frontend - Environment Configuration Template
# Copy this file to .env at the root of the project to customize API connectivity.
# Expo automatically exposes variables prefixed with EXPO_PUBLIC_ to the client app.
# ==============================================================================

# OPTION 1: Set full URLs directly
# Local Web development (default):
EXPO_PUBLIC_API_URL=http://localhost:5000/api
EXPO_PUBLIC_ML_URL=http://localhost:8002

# Physical Android Phone on Local Wi-Fi (replace with your laptop's current Wi-Fi/LAN IP):
# EXPO_PUBLIC_API_URL=http://192.168.1.50:5000/api
# EXPO_PUBLIC_ML_URL=http://192.168.1.50:8002

# OPTION 2: Set DEV HOST once (automatically configures both Express on port 5000 and ML on port 8002)
# EXPO_PUBLIC_DEV_HOST=192.168.1.50

# OPTION 3: Android Emulator (uses 10.0.2.2 host loopback)
# EXPO_PUBLIC_USE_EMULATOR=true
