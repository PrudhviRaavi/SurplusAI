# ==============================================================================
# FoodShareAI Mobile/Web Frontend - Environment Configuration Template
# Copy this file to .env at the root of the project to customize API connectivity.
# Expo automatically exposes variables prefixed with EXPO_PUBLIC_ to the client app.
# ==============================================================================

# Backend API Base URL
# For local Web development (localhost):
EXPO_PUBLIC_API_URL=http://localhost:5000/api

# For Android Emulator (maps to host loopback):
# EXPO_PUBLIC_API_URL=http://10.0.2.2:5000/api

# For Physical Device on Local Wi-Fi (replace with your development computer's LAN IP):
# EXPO_PUBLIC_API_URL=http://192.168.1.100:5000/api

# For Production Deployed Backend:
# EXPO_PUBLIC_API_URL=https://api.foodshareai.org/api
